{
  "name": "@app/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./test/database.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=../../.env src/seed.ts",
    "db:seed:dev": "tsx --env-file=../../.env src/seed-dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude \"**/*.int.test.ts\"",
    "test:int": "vitest run --passWithNoTests int.test.ts"
  },
  "dependencies": {
    "@app/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
