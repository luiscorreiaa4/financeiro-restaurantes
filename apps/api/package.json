{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file=../../.env src/worker.ts",
    "start:worker": "tsx --env-file=../../.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:int": "vitest run int.test.ts"
  },
  "dependencies": {
    "@app/core": "workspace:*",
    "@app/db": "workspace:*",
    "@app/whatsapp": "workspace:*",
    "fastify": "^5.12.7",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15"
  }
}
