{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:int *)",
      "Bash(pnpm --filter @app/api typecheck)",
      "Bash(pnpm --filter @app/api typecheck *)",
      "Bash(pnpm --filter @app/api test)",
      "Bash(pnpm --filter @app/api test *)",
      "Bash(pnpm --filter @app/web typecheck)",
      "Bash(pnpm --filter @app/web typecheck *)",
      "Bash(pnpm --filter @app/web test)",
      "Bash(pnpm --filter @app/web test *)",
      "Bash(pnpm --filter @app/ai typecheck)",
      "Bash(pnpm --filter @app/ai typecheck *)",
      "Bash(pnpm --filter @app/ai test)",
      "Bash(pnpm --filter @app/ai test *)",
      "Bash(pnpm --filter @app/config typecheck)",
      "Bash(pnpm --filter @app/config typecheck *)",
      "Bash(pnpm --filter @app/config test)",
      "Bash(pnpm --filter @app/config test *)",
      "Bash(pnpm --filter @app/core typecheck)",
      "Bash(pnpm --filter @app/core typecheck *)",
      "Bash(pnpm --filter @app/core test)",
      "Bash(pnpm --filter @app/core test *)",
      "Bash(pnpm --filter @app/db typecheck)",
      "Bash(pnpm --filter @app/db typecheck *)",
      "Bash(pnpm --filter @app/db test)",
      "Bash(pnpm --filter @app/db test *)",
      "Bash(pnpm --filter @app/whatsapp typecheck)",
      "Bash(pnpm --filter @app/whatsapp typecheck *)",
      "Bash(pnpm --filter @app/whatsapp test)",
      "Bash(pnpm --filter @app/whatsapp test *)",
      "Bash(pnpm --filter @app/api test:int)",
      "Bash(pnpm --filter @app/api test:int *)",
      "Bash(pnpm --filter @app/db test:int)",
      "Bash(pnpm --filter @app/db test:int *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(!.env.example)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\biome-format.ps1\"",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "Formatando com Biome..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": true
  }
}
