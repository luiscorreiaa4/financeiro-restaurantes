# Geral
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
TZ=America/Sao_Paulo

# Banco
DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/app
DATABASE_INGEST_URL=postgres://app_ingest:app_ingest@localhost:5432/app

# Auth
AUTH_SECRET=

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# IA
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-haiku-5-5
AI_MODEL_ADVANCED=claude-sonnet-5-5
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Armazenamento (S3-compatível)
S3_ENDPOINT=
S3_REGION=sa-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Observabilidade
SENTRY_DSN=
LOG_LEVEL=info
