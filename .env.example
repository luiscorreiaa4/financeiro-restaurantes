# Geral
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
TZ=America/Sao_Paulo

# Banco
DATABASE_URL=postgres://app:app@localhost:5434/app
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5434/app
DATABASE_INGEST_URL=postgres://app_ingest:app_ingest@localhost:5434/app
DATABASE_AUTH_URL=postgres://app_auth:app_auth@localhost:5434/app

# Auth
# Gere com: openssl rand -base64 32
AUTH_SECRET=
# Em desenvolvimento os e-mails (códigos) são gravados nesta pasta
DEV_MAIL_DIR=.dev-mail

# Canal: dev = chat de terminal (pnpm dev:chat); whatsapp = envio real (E10, nunca junto de dev em produção)
CHANNEL_MODE=dev
# Número do WhatsApp do produto mostrado no fim do cadastro (link wa.me e QR Code), com DDI.
# Público (vai para o navegador). Vazio = a tela avisa que o número não foi configurado.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Contato de suporte citado nas mensagens de ajuda (e-mail ou telefone). Vazio = "fale com o suporte"
SUPPORT_CONTACT=

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# IA
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-haiku-5-5
AI_MODEL_ADVANCED=claude-sonnet-5-5
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-transcribe
DEV_MEDIA_DIR=.dev-media
WHATSAPP_API_VERSION=v21.0

# Armazenamento (S3-compatível)
S3_ENDPOINT=
S3_REGION=sa-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Observabilidade
SENTRY_DSN=
LOG_LEVEL=info
